FROM node:18-bookworm

LABEL maintainer="S Davis<sdavis@nativeit.net>"

WORKDIR /app
RUN apt-get update && apt-get dist-upgrade -y && \
  apt-get install -y git curl zip bzip2 make nano && \
  git config --global user.email "dev@nativeit.net" && \
  git config --global user.name "Native IT" && \
  git clone -b dev https://github.com/nativeit-dev/massCode.git /app && \
  npm install -g pnpm && pnpm install && \
  npm install electron --save-dev && \
  pnpm run build:ts && pnpm run build && \
  make package
  # apt-get clean -y && apt-get autoclean -y && apt-get autoremove -y && \
  # rm -rf /var/lib/apt/lists/* /var/lib/log/* /tmp/* /var/tmp/*1
